[Unit]
Description=sss-tiktok API (FastAPI + Playwright)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/sss-tiktok-api.env
Environment="PROJECT_DIR=%h/Área de trabalho/sss-tiktok"
Environment="HOST=0.0.0.0"
Environment="PORT=8000"
WorkingDirectory=%h
ExecStart=/usr/bin/bash -lc 'cd "${PROJECT_DIR}" && exec "${PROJECT_DIR}/.venv/bin/python" api.py --host "${HOST}" --port "${PORT}"'
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=default.target
